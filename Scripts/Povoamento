-- =====================================================================================
-- 4. GERAÇÃO ALEATÓRIA EM MASSA DE VENDAS (dados "de ruído" para volume/performance)
--    A probabilidade de inadimplência aumenta conforme a Selic do mês sobe,
--    dando base real para a view vw_correlacao_inadimplencia_juros (RF003).
-- =====================================================================================
DELIMITER $$
 
CREATE PROCEDURE sp_povoar_vendas_ficticias()
BEGIN
    DECLARE done INT DEFAULT 0;
    DECLARE v_sk_tempo INT;
    DECLARE v_taxa_selic DECIMAL(5,2);
    DECLARE v_ano_mes VARCHAR(7);
    DECLARE v_qtd_vendas_mes INT;
    DECLARE i INT;
    DECLARE v_sk_cliente INT;
    DECLARE v_sk_produto INT;
    DECLARE v_preco DECIMAL(10,2);
    DECLARE v_quantidade INT;
    DECLARE v_dia INT;
    DECLARE v_metodo VARCHAR(30);
    DECLARE v_status VARCHAR(30);
    DECLARE v_prob_inadimplencia DECIMAL(6,4);
    DECLARE v_data_venda DATETIME;
 
    DECLARE cur CURSOR FOR
        SELECT sk_tempo, taxa_selic_ano, ano_mes_competencia
        FROM dim_macroeconomia
        ORDER BY sk_tempo;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;
 
    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_sk_tempo, v_taxa_selic, v_ano_mes;
        IF done THEN
            LEAVE read_loop;
        END IF;
 
        -- volume de vendas do mês (leve variação aleatória, entre 25 e 40 vendas)
        SET v_qtd_vendas_mes = 25 + FLOOR(RAND() * 15);
 
        -- probabilidade de inadimplência cresce com a Selic (regra de correlação)
        SET v_prob_inadimplencia = LEAST(0.35, GREATEST(0.03, (v_taxa_selic - 8) * 0.035));
 
        SET i = 0;
        WHILE i < v_qtd_vendas_mes DO
            SELECT sk_cliente INTO v_sk_cliente
            FROM dim_clientes
            WHERE id_cliente_origem LIKE 'CLI-0%'
            ORDER BY RAND() LIMIT 1;
 
            SELECT sk_produto, preco_venda_atual INTO v_sk_produto, v_preco
            FROM dim_produtos
            ORDER BY RAND() LIMIT 1;
 
            SET v_quantidade = 1 + FLOOR(RAND() * 4);
            SET v_dia = 1 + FLOOR(RAND() * 27);
            SET v_data_venda = STR_TO_DATE(
                CONCAT(v_ano_mes, '-', LPAD(v_dia, 2, '0'), ' ',
                       LPAD(FLOOR(RAND() * 23), 2, '0'), ':',
                       LPAD(FLOOR(RAND() * 59), 2, '0'), ':00'),
                '%Y-%m-%d %H:%i:%s'
            );
 
            SET v_metodo = ELT(1 + FLOOR(RAND() * 3), 'Pix', 'Crédito', 'Boleto');
 
            IF RAND() < 0.06 THEN
                SET v_status = 'Cancelado';
            ELSEIF RAND() < v_prob_inadimplencia THEN
                SET v_status = 'Inadimplente';
            ELSE
                SET v_status = 'Aprovado';
            END IF;
 
            INSERT INTO fct_vendas (
                id_venda_origem, fk_cliente, fk_produto, fk_tempo,
                data_venda, quantidade, valor_unitario, valor_total,
                metodo_pagamento, status_pagamento
            ) VALUES (
                CONCAT('BULK-', v_ano_mes, '-', LPAD(i, 4, '0')),
                v_sk_cliente, v_sk_produto, v_sk_tempo,
                v_data_venda, v_quantidade, v_preco, v_preco * v_quantidade,
                v_metodo, v_status
            );
 
            SET i = i + 1;
        END WHILE;
    END LOOP;
    CLOSE cur;
END$$
 
DELIMITER ;
 
CALL sp_povoar_vendas_ficticias();
DROP PROCEDURE sp_povoar_vendas_ficticias;
 
 
